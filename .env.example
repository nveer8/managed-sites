# Absolute URL of the marketing site (canonical URLs, sitemap). Defaults to https://webbr.example
NEXT_PUBLIC_SITE_URL=

# Extra comma-separated hosts that serve the marketing site + /sites previews (e.g. a staging domain)
PLATFORM_HOSTS=

# Optional: POST every validated lead as JSON to this URL. Unset = leads are logged to the server console.
LEAD_WEBHOOK_URL=
