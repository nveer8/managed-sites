{
  "name": "managed-sites",
  "version": "0.1.0",
  "private": true,
  "description": "Shared site engine and marketing site for a managed-website service for home-service contractors.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
